FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# Install system deps
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      python3 python3-venv python3-dev python3-pip \
      git curl ca-certificates nano htop tmux net-tools iputils-ping procps \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user early
RUN useradd -m comfy && \
    mkdir -p /workspace/runpod-slim && \
    chown -R comfy:comfy /workspace

USER comfy
WORKDIR /workspace/runpod-slim

# Clone ComfyUI
RUN git clone https://github.com/comfyanonymous/ComfyUI.git ComfyUI

WORKDIR /workspace/runpod-slim/ComfyUI

# Install PyTorch + deps
RUN python3 -m pip install --no-cache-dir --upgrade pip && \
    python3 -m pip install --no-cache-dir \
      torch torchvision torchaudio \
      --index-url https://download.pytorch.org/whl/cu124 && \
    python3 -m pip install --no-cache-dir -r requirements.txt

# Custom nodes
RUN git clone https://github.com/ltdrdata/ComfyUI-Manager.git custom_nodes/ComfyUI-Manager && \
    git clone https://github.com/kijai/ComfyUI-KJNodes custom_nodes/ComfyUI-KJNodes && \
    python3 -m pip install --no-cache-dir \
      -r custom_nodes/ComfyUI-Manager/requirements.txt || true && \
    python3 -m pip install --no-cache-dir \
      -r custom_nodes/ComfyUI-KJNodes/requirements.txt || true

# Create standard model dirs
RUN mkdir -p models/checkpoints models/vae models/clip models/loras

# Copy entrypoint & start script
COPY entrypoint_download_ckpt.sh /entrypoint_download_ckpt.sh
COPY start.sh /start.sh
RUN chmod +x /entrypoint_download_ckpt.sh /start.sh

# Default env vars
ENV CHECKPOINT_ID=""
ENV CIVITAI_API_KEY=""
ENV ENABLE_SSH="false"

# Healthcheck (helps serverless know when ready)
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=5 \
  CMD curl -f http://localhost:8188 || exit 1

EXPOSE 8188 22

ENTRYPOINT ["/entrypoint_download_ckpt.sh"]
CMD ["--listen", "0.0.0.0", "--port", "8188"]
